{
	"schemaVersion": 1,
	"id": "chordal",
	"version": "${version}",
	"name": "Chordal",
	"description": "A mod that implements a playable guitar using chords.",
	"authors": [
		"kratulidra"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/chordal/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"kratulidra.chordal.Chordal"
		],
		"client": [
			"kratulidra.chordal.client.ChordalClient"
		]
	},
	"mixins": [
		"chordal.mixins.json",
		{
			"config": "chordal.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}